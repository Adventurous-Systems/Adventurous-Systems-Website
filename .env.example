# Google Apps Script Web App URL for contact/community forms
VITE_GOOGLE_SCRIPT_URL=YOUR_MOCK_OR_PRODUCTION_SCRIPT_URL_HERE

# Optional: override the AI Readiness Assessment submission endpoint.
# Falls back to VITE_GOOGLE_SCRIPT_URL when omitted.
VITE_ASSESSMENT_SCRIPT_URL=

# Optional Umami analytics configuration. Leave blank to disable analytics.
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_HOST_URL=
VITE_UMAMI_DOMAINS=www.adventurous.systems,adventurous.systems
